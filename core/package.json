{
  "name": "life-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The shared core every life-data client runs: catalog validation, sync, the write path and the view model, with platform adapters injected.",
  "exports": {
    ".": "./src/index.ts",
    "./schema/saved-views.json": "./schema/saved-views.json",
    "./schema/view-defaults.json": "./schema/view-defaults.json",
    "./schema/related-view-defaults.json": "./schema/related-view-defaults.json",
    "./schema/sidebar-pins.json": "./schema/sidebar-pins.json",
    "./enrollment": "./src/enrollment.ts",
    "./creation": "./src/creation.ts",
    "./consumer-config": "./src/consumer-config.ts",
    "./query": "./src/query.ts",
    "./capture": "./src/capture.ts",
    "./schema/catalog-log.json": "./schema/catalog-log.json"
  },
  "files": [
    "src",
    "schema",
    "contract",
    "generated"
  ],
  "scripts": {
    "test": "bun test",
    "check": "bun ../scripts/generate-core-contract.ts --check && tsc --noEmit"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "5"
  }
}
