    {
      "name": "trim and encode approval label",
      "operation": "enrollmentApproval",
      "args": {
        "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "name": "  Example device & browser  "
      },
      "want": {
        "path": "/login?key=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&name=Example%20device%20%26%20browser",
        "approvalCode": "aaaaaaaa",
        "deviceName": "device:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "policy": {
          "pollIntervalSeconds": 5,
          "timeoutSeconds": 300,
          "maxResponseBytes": 65536
        }
      }
    },
    {
      "name": "uppercase hash",
      "operation": "enrollmentApproval",
